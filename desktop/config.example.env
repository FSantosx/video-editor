# Configurações do Video Editor no PC.
# O instalador copia este arquivo para config.env; edite o config.env e reinicie (Iniciar.bat).

# Porta da interface: http://localhost:8765
PORT=8765
OPEN_BROWSER=1

# Transcrição. Na RTX 3070 (8 GB), o large-v3-turbo é o melhor equilíbrio entre qualidade e
# velocidade. Opções: tiny, base, small, medium, large-v3-turbo, large-v3
WHISPER_MODEL=large-v3-turbo
# auto = GPU se disponível, senão CPU. Use cpu para forçar a CPU.
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=pt

# Cortes: formatos gerados para cada trecho (9:16 e/ou 1:1) e limites de duração
FORMATS=9:16,1:1
MAX_SHORTS=8
SHORT_MIN_S=30
SHORT_MAX_S=60
# Duração preferida: cortes mais curtos retêm melhor (o YouTube mostrou queda com 55s)
SHORT_TARGET_S=38
# Pausas maiores que isso (s) viram corte seco: menor = ritmo mais acelerado
PAUSE_CUT_S=0.25

# Abertura com teaser: começa com o momento mais forte do corte (até TEASER_MAX_S segundos)
# e depois volta ao início. Ataca quem desliza nos primeiros segundos.
TEASER_ENABLED=1
TEASER_MAX_S=3.5

# Título de gancho (texto na tela) e título do post. Com a chave da Anthropic o Claude escreve
# (crie em console.anthropic.com); sem chave usa uma heurística. auto | llm | heuristic
TITLES_ENGINE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Chamada no fim do corte, no topo da tela, nos últimos segundos
CTA_ENABLED=1
CTA_TEXT=E você, o que acha? Comenta aí!

# Vídeo: auto usa o NVENC da placa NVIDIA (rápido) e cai para x264 (CPU) se precisar
VIDEO_ENCODER=auto
NVENC_PRESET=p5
NVENC_CQ=21
CAPTION_FONT=Arial

# Quantos cortes renderizar ao mesmo tempo (a 3070 dá conta de 2 a 3 sessões NVENC)
WORKERS=2

# Pasta dos vídeos e cortes. Vazio = desktop\data dentro desta pasta.
# Ex.: DATA_DIR=D:\Cortes
DATA_DIR=
